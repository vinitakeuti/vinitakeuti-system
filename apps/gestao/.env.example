# Banco de dados PostgreSQL (use a URL interna do container do Postgres no EasyPanel)
DATABASE_URL="postgresql://vr:troque-esta-senha@postgres:5432/vr_gestao?schema=public"

# Chave com pelo menos 32 caracteres usada para criptografar as chaves das integrações (Asaas),
# cadastradas em Integrações na gestão. Não altere depois de conectar uma integração.
INTEGRATION_ENCRYPTION_KEY="troque-por-uma-chave-longa-e-aleatoria-com-32-caracteres"

# Autenticação e divisão dos portais. AUTH_SECRET deve ter 32+ caracteres
# aleatórios e nunca pode ser alterado enquanto existirem sessões ativas.
AUTH_SECRET="troque-por-uma-chave-longa-e-aleatoria-com-32-caracteres"
MANAGEMENT_HOST="gestao.vinitakeuti.com"
CLIENT_PORTAL_HOST="clientes.vinitakeuti.com"
