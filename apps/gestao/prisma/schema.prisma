generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  LEAD
  PROPOSAL
  PLANNING
  IN_PROGRESS
  WAITING_CLIENT
  DELIVERED
  PAUSED
  CANCELLED
}

enum ChargeStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  REFUNDED
  CANCELLED
}

enum MonitoringStatus {
  OPERATIONAL
  DEGRADED
  DOWN
  UNKNOWN
}

enum MonitoringEventType {
  UPTIME
  DEPLOYMENT
  SECURITY
  LOG
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  SIGNED
  EXPIRED
}

enum QuotePricingMethod {
  FIXED
  HOURLY
  DAILY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
}

enum ServiceBillingType {
  ONE_TIME
  RECURRING
}

enum ServicePricingMethod {
  FIXED
  HOURLY
  DAILY
  CUSTOM
}

enum SaleOrigin {
  QUOTE
  DIRECT
}

enum SaleStatus {
  PENDING
  CONFIRMED
  PAID
  CANCELLED
}

enum FinancialEntryType {
  INCOME
  EXPENSE
}

enum FinancialEntryStatus {
  PENDING
  SETTLED
  CANCELLED
}

enum FinancialEntryOrigin {
  MANUAL
  QUOTE
}

/// Perfis de acesso da operação e do portal do cliente.
enum UserRole {
  PROFESSIONAL
  COMMERCIAL
  MARKETING
  AFFILIATE
  ACCOUNTANT
  CLIENT
}

model Client {
  id             String          @id @default(cuid())
  name           String
  email          String?
  /// Identificação exibida nos documentos e PDFs ("CNPJ … · CPF …"), montada a partir de cpf e cnpj ao salvar.
  document       String?
  /// Só dígitos.
  cpf            String?
  /// Só dígitos.
  cnpj           String?
  phone          String?
  address        String?
  city           String?
  company        String?
  asaasCustomerId String?        @unique
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projects       Project[]
  charges        Charge[]
  quotes         Quote[]
  documents      ClientDocument[]
  sales          Sale[]
  contracts      Contract[]
  subscriptions  Subscription[]
  monitoredApps  MonitoredApp[]
  portalUsers    User[]
  paymentNotices PaymentNotice[]
  signedDocuments SignedDocument[]
  aiConversations AiConversation[]
  calendarEvents CalendarEvent[]

  @@index([name])
  @@index([email])
}

/// Conta autenticável. Clientes são vinculados ao respectivo cadastro para
/// que o portal futuro só exponha dados do próprio relacionamento.
model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(CLIENT)
  clientId     String?
  isActive     Boolean       @default(true)
  /// Senha provisória (gerada pela gestão e enviada por e-mail): o portal pede a troca antes de qualquer outra página.
  mustChangePassword Boolean @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions     AuthSession[]

  @@index([role, isActive])
  @@index([clientId, isActive])
}

/// Sessões revogáveis e com expiração explícita. O cookie assinado referencia
/// somente este registro, sem carregar dados pessoais no navegador.
model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PricingProfile {
  id String @id @default("default")
  internalHourlyCostCents Int @default(6000)
  targetMarginBps Int @default(4000)
  taxBps Int @default(600)
  riskReserveBps Int @default(1500)
  weeklyCapacityHours Int @default(30)
  minimumProjectCents Int @default(300000)
  updatedAt DateTime @updatedAt
}

model QuoteTextTemplate {
  id        String   @id @default("default")
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

model ProfessionalProfile {
  id                 String   @id @default("default")
  name               String   @default("Vinicius Riudi")
  professionalTitle  String?
  email              String?
  phone              String?
  document           String?
  address            String?
  city               String?
  state              String?
  website            String?
  /// Chave Pix e instruções mostradas ao cliente no portal quando não há pagamento online (Asaas).
  pixKey             String?
  paymentInstructions String?
  /// Assinatura do profissional para as folhas de assinatura dos PDFs: SVG reduzido aos traços (só elementos path).
  /// Fica no banco, nunca em public/, para não ficar acessível por um endereço público.
  signatureSvg       String?
  updatedAt          DateTime @updatedAt
}

model ServiceCategory {
  id        String               @id @default(cuid())
  name      String               @unique
  description String?
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  services  ServiceCatalogItem[]

  @@index([isActive, sortOrder, name])
}

model ServiceCatalogItem {
  id                 String             @id @default(cuid())
  categoryId         String
  name               String
  description        String?
  proposalText       String?
  billingType        ServiceBillingType
  pricingMethod      ServicePricingMethod @default(FIXED)
  defaultAmountCents Int                @default(0)
  estimatedHours     Int?
  billingCycle       String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  category           ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subscriptions      Subscription[]
  quoteItems         QuoteServiceItem[]

  @@index([categoryId, isActive, createdAt])
  @@index([isActive, createdAt])
}

model Project {
  id             String        @id @default(cuid())
  clientId       String
  name           String
  description    String?
  status         ProjectStatus @default(LEAD)
  budgetCents    Int?
  startedAt      DateTime?
  deliveryAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  monitoredApps  MonitoredApp[]
  charges        Charge[]
  quotes         Quote[]
  contracts      Contract[]

  @@index([clientId, status])
  @@index([deliveryAt])
}

model Charge {
  id             String       @id @default(cuid())
  clientId       String
  projectId      String?
  description    String
  amountCents    Int
  dueDate        DateTime
  paidAt         DateTime?
  status         ChargeStatus @default(DRAFT)
  paymentMethod  String?
  asaasPaymentId String?      @unique
  invoiceUrl     String?
  /// Lançamento (e parcela) do Financeiro que esta cobrança paga, quando criada pelo portal do cliente.
  financialEntryId String?
  installmentNumber Int?
  /// Última parcela coberta, quando o cliente paga várias de uma vez (da installmentNumber até esta). Null: só uma.
  installmentThrough Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([clientId, dueDate])
  @@index([financialEntryId, installmentNumber])
}

model Quote {
  id              String         @id @default(cuid())
  clientId        String
  projectId       String?
  code            String         @unique
  title           String
  scope           String
  estimatedHours  Int
  estimatedDays   Int
  pricingMethod   QuotePricingMethod @default(FIXED)
  pricingRateCents Int?
  amountCents     Int
  discountCents   Int            @default(0)
  /// Desconto percentual em pontos-base (1050 = 10,5%). Nulo quando o desconto é um valor fixo.
  discountPercentBps Int?
  costCents       Int?
  documentContent Json?
  terms           String?
  validUntil      DateTime?
  status          DocumentStatus @default(DRAFT)
  aiAnalysis      Json?
  paymentNotes    String?
  /// Null enquanto o orçamento estiver pendente de conclusão no editor.
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items           QuoteServiceItem[]
  payments        QuotePayment[]
  images          QuoteImage[]
  documents       ClientDocument[]
  sale            Sale?
  signedCopies    SignedDocument[]

  @@index([status, validUntil])
  @@index([status, createdAt, id])
  @@index([clientId, createdAt])
  @@index([completedAt, updatedAt, id])
}

/// Valores já recebidos que abatem o total de um orçamento.
model QuotePayment {
  id          String   @id @default(cuid())
  quoteId     String
  amountCents Int
  paidAt      DateTime
  createdAt   DateTime @default(now())
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, paidAt, id])
}

/// Imagens inseridas no PDF de um orçamento ou de um documento do cliente. Arquivos pequenos (até 4 MB), limitados por documento.
model QuoteImage {
  id         String          @id @default(cuid())
  quoteId    String?
  documentId String?
  mimeType   String
  width      Int
  height     Int
  byteSize   Int
  data       Bytes
  createdAt  DateTime        @default(now())
  quote      Quote?          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  document   ClientDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([documentId, createdAt])
}

enum ClientDocumentKind {
  CONTRACT
  IP_ASSIGNMENT
  TECHNICAL_MEMORIAL
  /// Documento livre: capa opcional, sem folha final e com cliente opcional.
  FREE
}

/// Documentos produzidos além da proposta comercial: contrato, cessão de direitos, memorial técnico e documento livre.
model ClientDocument {
  id              String             @id @default(cuid())
  /// Obrigatório nos documentos do cliente; opcional no documento livre.
  clientId        String?
  /// Proposta de referência: traz os serviços para o documento. Opcional.
  quoteId         String?
  kind            ClientDocumentKind
  code            String             @unique
  title           String
  documentContent Json?
  /// Null enquanto o documento estiver pendente de conclusão no editor.
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  client          Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote           Quote?             @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  images          QuoteImage[]
  signedCopies    SignedDocument[]

  @@index([clientId, kind, createdAt])
  @@index([kind, updatedAt, id])
  @@index([updatedAt, id])
  @@index([quoteId])
}

model Sale {
  id          String     @id @default(cuid())
  clientId    String
  quoteId     String?    @unique
  code        String     @unique
  title       String
  description String?
  amountCents Int
  origin      SaleOrigin
  status      SaleStatus @default(PENDING)
  confirmedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote       Quote?     @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdAt, id])
  @@index([clientId, createdAt])
}

/// Livro-caixa. Mantém snapshots textuais para preservar o histórico mesmo
/// quando o cadastro ou documento de origem for alterado posteriormente.
model FinancialEntry {
  id           String               @id @default(cuid())
  type         FinancialEntryType
  status       FinancialEntryStatus @default(PENDING)
  origin       FinancialEntryOrigin @default(MANUAL)
  sourceKey    String?              @unique
  description  String
  category     String
  counterparty String?
  amountCents  Int
  isFixed      Boolean              @default(false)
  dueDate      DateTime
  settledAt    DateTime?
  notes        String?
  /// Soma dos recebimentos (entradas) ou pagamentos (saídas) já registrados. Atualizada junto com FinancialPayment.
  paidCents    Int                  @default(0)
  /// Recorrência que gerou este lançamento (uma ocorrência por mês).
  recurringEntryId String?
  /// Condição especial de pagamento combinada ("Mensal no Pix", "Boleto em 10x"). Lançamentos com condição
  /// aparecem na área Condições especiais, independentemente da data.
  paymentCondition String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  payments     FinancialPayment[]
  installments FinancialInstallment[]
  recurringEntry RecurringEntry?    @relation(fields: [recurringEntryId], references: [id], onDelete: SetNull)

  @@index([status, dueDate, id])
  @@index([type, dueDate, id])
  @@index([createdAt, id])
  @@index([recurringEntryId, dueDate])
  @@index([paymentCondition, status, dueDate])
}

/// Parcelas de uma entrada: datas e valores combinados para receber. Os recebimentos registrados quitam as parcelas
/// em ordem (a primeira parcela primeiro). Sem parcelas, a entrada vence de uma vez no seu vencimento.
model FinancialInstallment {
  id          String         @id @default(cuid())
  entryId     String
  number      Int
  dueDate     DateTime
  amountCents Int
  createdAt   DateTime       @default(now())
  entry       FinancialEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, number])
  @@index([dueDate])
}

/// Entrada ou saída que se repete todo mês (custo fixo, mensalidade). Cada mês vira um FinancialEntry,
/// gerado sob demanda até o mês consultado. Dias que não existem no mês (31 em novembro) caem no último dia.
model RecurringEntry {
  id               String             @id @default(cuid())
  type             FinancialEntryType
  description      String
  category         String
  counterparty     String?
  amountCents      Int
  /// Dia do vencimento (1 a 31).
  dayOfMonth       Int
  /// Primeiro mês (dia 1, meio-dia UTC).
  startsOn         DateTime
  /// Último mês, quando encerrada.
  endsOn           DateTime?
  /// Último mês já gerado.
  generatedThrough DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  entries          FinancialEntry[]

  @@index([endsOn, generatedThrough])
  @@index([type, createdAt, id])
}

/// Valores efetivamente recebidos ou pagos de um lançamento. Um lançamento pode ser quitado em várias partes;
/// ele fica realizado quando a soma alcança o valor esperado.
model FinancialPayment {
  id          String         @id @default(cuid())
  entryId     String
  amountCents Int
  paidAt      DateTime
  notes       String?
  /// Quitação lançada ao marcar a venda como paga; sai se a venda voltar a ficar em aberto.
  fromSale    Boolean        @default(false)
  /// Pagamento registrado na proposta comercial; acompanha as alterações feitas nela.
  fromQuote   Boolean        @default(false)
  /// Cobrança online (Asaas) que gerou este pagamento; impede registrar o mesmo pagamento duas vezes.
  chargeId    String?        @unique
  createdAt   DateTime       @default(now())
  entry       FinancialEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, paidAt, id])
  @@index([paidAt])
}

model QuoteServiceItem {
  id                   String             @id @default(cuid())
  quoteId              String
  serviceCatalogItemId String?
  name                 String
  categoryName         String
  proposalText         String?
  billingType          ServiceBillingType
  pricingMethod        ServicePricingMethod @default(FIXED)
  billingCycle         String?
  quantity             Int                @default(1)
  pricingRateCents     Int?
  unitAmountCents      Int
  totalAmountCents     Int
  estimatedHours       Int?
  createdAt            DateTime           @default(now())
  quote                Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceCatalogItem   ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)

  @@index([quoteId, createdAt])
  @@index([serviceCatalogItemId])
}

model Subscription {
  id            String             @id @default(cuid())
  clientId      String
  serviceCatalogItemId String?
  name          String
  amountCents   Int
  billingCycle  String             @default("MONTHLY")
  status        SubscriptionStatus @default(ACTIVE)
  nextPaymentAt DateTime?
  startedAt     DateTime           @default(now())
  cancelledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  client        Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceCatalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([status, nextPaymentAt])
  @@index([serviceCatalogItemId, status])
}

model Contract {
  id              String         @id @default(cuid())
  clientId        String
  projectId       String?
  code            String         @unique
  title           String
  terms           String
  deliveryDate    DateTime?
  amountCents     Int?
  status          DocumentStatus @default(DRAFT)
  signedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model MonitoredApp {
  id                String           @id @default(cuid())
  clientId          String?
  projectId         String?
  name              String
  url               String?
  healthEndpoint    String?
  logsEndpoint      String?
  environment       String           @default("production")
  status            MonitoringStatus @default(UNKNOWN)
  lastCheckedAt     DateTime?
  lastResponseMs    Int?
  lastIncidentAt    DateTime?
  /// Resumo da última verificação ("HTTP 200 · banco ok 12 ms · versão 1.4.2").
  lastCheckSummary  String?
  /// Próxima verificação automática (o agendador reserva o sistema avançando esta data).
  nextCheckAt       DateTime?
  /// Último e-mail de alerta de indisponibilidade (para lembretes enquanto continuar fora).
  lastAlertAt       DateTime?
  sslExpiresAt      DateTime?
  sslIssuer         String?
  sslCheckedAt      DateTime?
  sslError          String?
  /// Menor aviso de vencimento já enviado (30, 7 ou 1 dia), para não repetir.
  sslAlertedDays    Int?
  domainName        String?
  domainExpiresAt   DateTime?
  domainCheckedAt   DateTime?
  domainError       String?
  domainAlertedDays Int?
  /// Stack informada pelo endpoint de saúde: [{ name, version, ecosystem }] (npm, pypi).
  stack             Json?
  /// Atualizações disponíveis na última conferência: [{ name, ecosystem, current, latest, level }].
  stackUpdates      Json?
  stackCheckedAt    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  client            Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events            MonitoringEvent[]
  checks            MonitoringCheck[]

  @@index([status, lastCheckedAt])
  @@index([nextCheckAt])
  @@index([clientId, createdAt, id])
  @@index([stackCheckedAt])
}

model MonitoringEvent {
  id             String              @id @default(cuid())
  monitoredAppId String
  type           MonitoringEventType
  severity       String              @default("info")
  title          String
  details        String?
  metadata       Json?
  occurredAt     DateTime            @default(now())
  resolvedAt     DateTime?
  monitoredApp   MonitoredApp        @relation(fields: [monitoredAppId], references: [id], onDelete: Cascade)

  @@index([monitoredAppId, occurredAt])
  @@index([type, severity])
}

/// Integração de pagamentos (Asaas), configurada em Integrações na gestão. A chave fica criptografada
/// (INTEGRATION_ENCRYPTION_KEY) e do token do webhook só se guarda o hash.
model PaymentIntegration {
  id                    String   @id @default(cuid())
  provider              String   @unique
  isActive              Boolean  @default(false)
  environment           String   @default("sandbox")
  apiKeyEncrypted       String?
  /// Últimos 4 caracteres da chave, para identificar qual está salva.
  keyHint               String?
  webhookTokenHash      String?
  webhookId             String?
  webhookUrl            String?
  /// Situação do webhook no Asaas: ACTIVE, INTERRUPTED (fila parada), DISABLED ou MISSING.
  webhookStatus         String?
  webhookPenalized      Int?
  accountName           String?
  accountEmail          String?
  accountDocument       String?
  accountStatus         String?
  /// Última verificação da conexão e do webhook, com o erro, se houve.
  lastCheckedAt         DateTime?
  lastError             String?
  /// Última conferência das cobranças em aberto direto no Asaas (cobre webhooks perdidos).
  lastSyncAt            DateTime?
  /// Cobrança automática: a cobrança da próxima parcela é gerada no Asaas estes dias antes do vencimento. Null desliga.
  autoChargeDays        Int?     @default(7)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model GatewayEvent {
  id                String   @id @default(cuid())
  provider          String
  eventKey          String   @unique
  eventName         String
  providerPaymentId String?
  amountCents       Int?
  occurredAt        DateTime?
  processedAt       DateTime?
  error             String?
  /// Tentativas de processamento (o agendador reprocessa até 5 vezes).
  attempts          Int      @default(0)
  /// Só os campos da cobrança usados no processamento (status, valor e datas), não o payload inteiro.
  payload           Json?
  receivedAt        DateTime @default(now())

  @@index([provider, receivedAt])
  @@index([processedAt, receivedAt])
  @@index([providerPaymentId])
}

/// Envios de e-mail (testes e, depois, os automáticos), com o resultado do servidor SMTP.
model EmailLog {
  id          String   @id @default(cuid())
  kind        String
  status      String
  toAddress   String
  subject     String
  messageId   String?
  /// Resposta do servidor SMTP ou diagnóstico da conexão (limitado).
  response    String?
  error       String?
  durationMs  Int?
  actorEmail  String?
  createdAt   DateTime @default(now())

  @@index([createdAt, id])
  @@index([status, createdAt])
}

/// Eventos da aplicação (logins, senhas, acessos, envios e erros), separados por origem e nível.
/// Append-only, com retenção de 90 dias.
/// Fila de e-mails para clientes: o envio acontece fora da requisição (logo depois da resposta e no ciclo do
/// agendador, com novas tentativas). Depois de enviado, o corpo é apagado; o resultado fica em EmailLog.
model EmailOutbox {
  id          String    @id @default(cuid())
  kind        String
  toAddress   String
  subject     String
  html        String
  text        String
  /// PENDING, SENDING, SENT ou FAILED (desistiu depois das tentativas).
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  /// Evita o mesmo aviso duas vezes (lembrete da mesma parcela, documento já anunciado).
  dedupeKey   String?   @unique
  clientId    String?
  sendAfter   DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, sendAfter])
  @@index([createdAt, id])
}

model SystemLog {
  id         String   @id @default(cuid())
  source     String
  level      String
  event      String
  message    String
  actorEmail String?
  ip         String?
  userAgent  String?
  /// Detalhes pequenos e sem segredos.
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt, id])
  @@index([source, level, createdAt])
  @@index([event, createdAt])
}

/// Cada verificação de um sistema monitorado (manual ou automática), para uptime e tempo de resposta. Retenção de 90 dias.
model MonitoringCheck {
  id             String           @id @default(cuid())
  monitoredAppId String
  status         MonitoringStatus
  responseMs     Int
  statusCode     Int?
  summary        String?
  checkedAt      DateTime         @default(now())
  monitoredApp   MonitoredApp     @relation(fields: [monitoredAppId], references: [id], onDelete: Cascade)

  @@index([monitoredAppId, checkedAt])
  @@index([checkedAt])
}

/// Estado das tarefas agendadas (por exemplo, a data do último resumo diário enviado).
model SchedulerState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Aviso do cliente, pelo portal, de que fez um pagamento (Pix ou transferência). Você confere e registra no Financeiro.
model PaymentNotice {
  id                String    @id @default(cuid())
  clientId          String
  financialEntryId  String
  installmentNumber Int?
  amountCents       Int
  paidOn            DateTime
  message           String?
  /// PENDING até você registrar o pagamento ou descartar o aviso.
  status            String    @default("PENDING")
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([financialEntryId, status])
  @@index([clientId, createdAt])
  @@index([status, createdAt])
}

/// Via assinada de uma proposta ou documento, enviada pelo cliente no portal (PDF assinado no assinador gov.br).
/// Arquivo limitado a 8 MB e a 5 envios por documento; o conteúdo só é lido no download.
enum SignedDocumentReview {
  IN_REVIEW
  APPROVED
  REJECTED
}

model SignedDocument {
  id                String          @id @default(cuid())
  clientId          String
  quoteId           String?
  documentId        String?
  fileName          String
  byteSize          Int
  sha256            String
  data              Bytes
  uploadedBy        String?
  /// Conferência manual na gestão: a via só conta como assinada depois de aprovada.
  reviewStatus      SignedDocumentReview @default(IN_REVIEW)
  reviewedAt        DateTime?
  reviewedBy        String?
  /// Motivo mostrado ao cliente quando a via é recusada.
  rejectionReason   String?
  createdAt         DateTime        @default(now())
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote             Quote?          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  document          ClientDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([documentId, createdAt])
  @@index([clientId, createdAt])
}

/// Canal por onde a conversa com a IA chegou. Define o escopo das ferramentas: gestão e WhatsApp (dono) podem
/// alterar o sistema; o portal só lê os dados do próprio cliente; o site só responde sobre serviços e contato.
enum AiChannel {
  GESTAO
  PORTAL
  SITE
  WHATSAPP
  SISTEMA
}

/// Novo (ninguém tratou ainda), em andamento, convertido (virou cliente ou proposta) ou arquivado.
enum AttendanceStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  ARCHIVED
}

enum AiRunStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Configuração da IA (uma linha, "default"), feita em Integrações. A chave fica criptografada
/// (INTEGRATION_ENCRYPTION_KEY) e do token de acesso externo (MCP e mensagens) só se guarda o hash.
model AiSettings {
  id                  String    @id @default("default")
  isActive            Boolean   @default(false)
  /// openrouter, anthropic, openai, gemini ou custom (qualquer API compatível com a da OpenAI).
  provider            String    @default("openrouter")
  baseUrl             String?
  model               String?
  apiKeyEncrypted     String?
  keyHint             String?
  /// Canais liberados: GESTAO, PORTAL, SITE, WHATSAPP.
  channels            String[]  @default([])
  /// Números de WhatsApp do dono (só dígitos, com DDI): mensagens deles têm acesso de gestão; as demais são recusadas.
  ownerPhones         String[]  @default([])
  /// Alterações pedidas à IA (lançar gasto, confirmar venda) esperam um "sim" da pessoa antes de executar.
  requireConfirmation Boolean   @default(true)
  /// Instruções gerais: valem em todas as conversas (quem é você, tom, regras do negócio).
  instructions        String?
  /// Instruções de atendimento: só nas conversas com clientes e visitantes (site, área do cliente, WhatsApp).
  serviceInstructions String?
  /// Atende pelo WhatsApp números que não são do dono, em modo atendimento (serviços e contato).
  whatsappAttendance  Boolean   @default(false)
  /// Nome da assistente (ex.: Eliza), usado na apresentação e na saudação do site.
  assistantName       String?
  /// Limite de execuções por dia (todas as origens), para conter custo. Null = sem limite.
  dailyRunLimit       Int?      @default(300)
  /// Preço do modelo em micro-dólares por milhão de tokens (US$ 3,00 = 3000000), para calcular o custo quando o
  /// provedor não informa o custo de cada resposta. Preenchido pela lista de modelos ou à mão.
  inputPriceMicros    Int?
  outputPriceMicros   Int?
  /// Cotação para mostrar o custo em reais, em centavos por dólar (R$ 5,50 = 550). Null mostra só em dólar.
  usdBrlCents         Int?
  /// Modelo de cada tarefa (vazio = o modelo da gestão, em `model`): atendimento (site, WhatsApp de clientes, área
  /// do cliente), documentos e contratos (criar e revisar) e orçamentos (montar e alterar).
  attendanceModel     String?
  documentModel       String?
  quoteModel          String?
  /// Preço de cada modelo usado, em micro-dólares por milhão de tokens: { "modelo": { "input": 3000000, "output": 15000000 } }.
  modelPrices         Json?
  externalTokenHash   String?
  externalTokenHint   String?
  lastCheckedAt       DateTime?
  lastError           String?
  updatedAt           DateTime  @updatedAt
}

model AiConversation {
  id            String         @id @default(cuid())
  channel       AiChannel
  /// Cliente da conversa (portal) ou citado nela.
  clientId      String?
  /// Usuário autenticado (gestão ou portal) que iniciou.
  userId        String?
  /// Identificador externo: sessão do visitante no site ou número do WhatsApp.
  externalKey   String?
  title         String?
  /// Contato informado pelo visitante para iniciar o atendimento no site (obrigatório nele).
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  /// Resumo do atendimento registrado pela IA (objetivo do cliente, serviços de interesse, próximo passo).
  summary       String?
  summaryUpdatedAt DateTime?
  /// Situação do atendimento na tela Atendimentos (só nas conversas com clientes e visitantes).
  attendanceStatus AttendanceStatus @default(NEW)
  /// Anotações suas sobre o atendimento.
  ownerNotes    String?
  createdAt     DateTime       @default(now())
  lastMessageAt DateTime       @default(now())
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  messages      AiMessage[]
  runs          AiRun[]
  actions       AiAction[]
  events        CalendarEvent[]

  @@unique([channel, externalKey])
  @@index([channel, lastMessageAt, id])
  @@index([attendanceStatus, lastMessageAt, id])
  @@index([clientId, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@index([lastMessageAt])
}

/// Mensagens da conversa: as da pessoa, as respostas da IA e os resultados das ferramentas (conteúdo limitado).
model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  /// user, assistant ou tool.
  role           String
  content        String
  /// Ferramentas pedidas pela IA nesta resposta: [{ id, name, input }].
  toolCalls      Json?
  toolCallId     String?
  toolName       String?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
}

/// Cada vez que a IA responde a uma mensagem: fila, tentativas, modelo usado e consumo de tokens.
model AiRun {
  id             String         @id @default(cuid())
  conversationId String
  status         AiRunStatus    @default(PENDING)
  attempts       Int            @default(0)
  provider       String?
  model          String?
  steps          Int            @default(0)
  inputTokens    Int            @default(0)
  outputTokens   Int            @default(0)
  /// Custo da resposta em micro-dólares (US$ 0,09 = 90000): o informado pelo provedor ou o calculado pelo preço do
  /// modelo no momento. Null quando não havia como saber.
  costMicros     Int?
  error          String?
  createdAt      DateTime       @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([conversationId, createdAt])
  @@index([createdAt, id])
}

/// Auditoria das ferramentas chamadas pela IA (append-only). Alterações que pedem confirmação ficam
/// PENDING_CONFIRMATION até a pessoa responder "sim" na mesma conversa.
model AiAction {
  id             String         @id @default(cuid())
  conversationId String
  runId          String?
  tool           String
  input          Json
  result         Json?
  /// DONE, ERROR, DENIED, PENDING_CONFIRMATION, CONFIRMED, EXPIRED.
  status         String
  mutates        Boolean        @default(false)
  actor          String?
  createdAt      DateTime       @default(now())
  decidedAt      DateTime?
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt, id])
}

enum CalendarEventStatus {
  SCHEDULED
  CANCELLED
  DONE
}

/// Agenda: reuniões, compromissos e lembretes. Pode vir da gestão (você), da IA da gestão ou da IA do atendimento
/// (reunião marcada com um cliente ou interessado, com o contato e o resumo da conversa).
model CalendarEvent {
  id             String              @id @default(cuid())
  title          String
  description    String?
  /// MEETING (reunião), APPOINTMENT (compromisso) ou REMINDER (lembrete).
  kind           String              @default("MEETING")
  startsAt       DateTime
  endsAt         DateTime
  location       String?
  status         CalendarEventStatus @default(SCHEDULED)
  clientId       String?
  /// Contato de quem não é cliente cadastrado (visitante do site, número do WhatsApp).
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  /// Conversa com a IA que gerou o evento (atendimento), para abrir o resumo e o histórico.
  conversationId String?
  /// gestao, ia-gestao ou ia-atendimento.
  source         String              @default("gestao")
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  client         Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  conversation   AiConversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status, startsAt])
  @@index([startsAt, id])
  @@index([clientId, startsAt])
  @@index([conversationId])
}

/// Disponibilidade para reuniões (uma linha, "default"): dias e horários de atendimento, duração e regras de
/// antecedência. A IA do atendimento só oferece horários livres dentro destas regras.
model AgendaSettings {
  id             String   @id @default("default")
  /// Dias da semana com atendimento (0 = domingo … 6 = sábado).
  workDays       Int[]    @default([1, 2, 3, 4, 5])
  /// Minutos desde a meia-noite (horário de Brasília): 540 = 09:00.
  dayStart       Int      @default(540)
  dayEnd         Int      @default(1080)
  breakStart     Int?     @default(720)
  breakEnd       Int?     @default(780)
  meetingMinutes Int      @default(30)
  bufferMinutes  Int      @default(15)
  minNoticeHours Int      @default(12)
  maxDaysAhead   Int      @default(21)
  /// Como a reunião acontece (ex.: "Google Meet, com o link enviado pelo WhatsApp").
  meetingFormat  String?
  /// A IA do atendimento pode marcar reuniões.
  aiBooking      Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}
