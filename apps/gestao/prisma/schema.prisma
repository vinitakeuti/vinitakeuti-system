generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  LEAD
  PROPOSAL
  PLANNING
  IN_PROGRESS
  WAITING_CLIENT
  DELIVERED
  PAUSED
  CANCELLED
}

enum ChargeStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  REFUNDED
  CANCELLED
}

enum MonitoringStatus {
  OPERATIONAL
  DEGRADED
  DOWN
  UNKNOWN
}

enum MonitoringEventType {
  UPTIME
  DEPLOYMENT
  SECURITY
  LOG
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  SIGNED
  EXPIRED
}

enum QuotePricingMethod {
  FIXED
  HOURLY
  DAILY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
}

enum ServiceBillingType {
  ONE_TIME
  RECURRING
}

enum ServicePricingMethod {
  FIXED
  HOURLY
  DAILY
  CUSTOM
}

enum SaleOrigin {
  QUOTE
  DIRECT
}

enum SaleStatus {
  PENDING
  CONFIRMED
  PAID
  CANCELLED
}

enum FinancialEntryType {
  INCOME
  EXPENSE
}

enum FinancialEntryStatus {
  PENDING
  SETTLED
  CANCELLED
}

enum FinancialEntryOrigin {
  MANUAL
  QUOTE
}

/// Perfis de acesso da operação e do portal do cliente.
enum UserRole {
  PROFESSIONAL
  COMMERCIAL
  MARKETING
  AFFILIATE
  ACCOUNTANT
  CLIENT
}

model Client {
  id             String          @id @default(cuid())
  name           String
  email          String?
  /// Identificação exibida nos documentos e PDFs ("CNPJ … · CPF …"), montada a partir de cpf e cnpj ao salvar.
  document       String?
  /// Só dígitos.
  cpf            String?
  /// Só dígitos.
  cnpj           String?
  phone          String?
  address        String?
  city           String?
  company        String?
  asaasCustomerId String?        @unique
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projects       Project[]
  charges        Charge[]
  quotes         Quote[]
  documents      ClientDocument[]
  sales          Sale[]
  contracts      Contract[]
  subscriptions  Subscription[]
  monitoredApps  MonitoredApp[]
  portalUsers    User[]
  paymentNotices PaymentNotice[]
  signedDocuments SignedDocument[]

  @@index([name])
  @@index([email])
}

/// Conta autenticável. Clientes são vinculados ao respectivo cadastro para
/// que o portal futuro só exponha dados do próprio relacionamento.
model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(CLIENT)
  clientId     String?
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions     AuthSession[]

  @@index([role, isActive])
  @@index([clientId, isActive])
}

/// Sessões revogáveis e com expiração explícita. O cookie assinado referencia
/// somente este registro, sem carregar dados pessoais no navegador.
model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PricingProfile {
  id String @id @default("default")
  internalHourlyCostCents Int @default(6000)
  targetMarginBps Int @default(4000)
  taxBps Int @default(600)
  riskReserveBps Int @default(1500)
  weeklyCapacityHours Int @default(30)
  minimumProjectCents Int @default(300000)
  updatedAt DateTime @updatedAt
}

model QuoteTextTemplate {
  id        String   @id @default("default")
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

model ProfessionalProfile {
  id                 String   @id @default("default")
  name               String   @default("Vinicius Riudi")
  professionalTitle  String?
  email              String?
  phone              String?
  document           String?
  address            String?
  city               String?
  state              String?
  website            String?
  /// Chave Pix e instruções mostradas ao cliente no portal quando não há pagamento online (Asaas).
  pixKey             String?
  paymentInstructions String?
  /// Assinatura do profissional para as folhas de assinatura dos PDFs: SVG reduzido aos traços (só elementos path).
  /// Fica no banco, nunca em public/, para não ficar acessível por um endereço público.
  signatureSvg       String?
  updatedAt          DateTime @updatedAt
}

model ServiceCategory {
  id        String               @id @default(cuid())
  name      String               @unique
  description String?
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  services  ServiceCatalogItem[]

  @@index([isActive, sortOrder, name])
}

model ServiceCatalogItem {
  id                 String             @id @default(cuid())
  categoryId         String
  name               String
  description        String?
  proposalText       String?
  billingType        ServiceBillingType
  pricingMethod      ServicePricingMethod @default(FIXED)
  defaultAmountCents Int                @default(0)
  estimatedHours     Int?
  billingCycle       String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  category           ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subscriptions      Subscription[]
  quoteItems         QuoteServiceItem[]

  @@index([categoryId, isActive, createdAt])
  @@index([isActive, createdAt])
}

model Project {
  id             String        @id @default(cuid())
  clientId       String
  name           String
  description    String?
  status         ProjectStatus @default(LEAD)
  budgetCents    Int?
  startedAt      DateTime?
  deliveryAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  monitoredApps  MonitoredApp[]
  charges        Charge[]
  quotes         Quote[]
  contracts      Contract[]

  @@index([clientId, status])
  @@index([deliveryAt])
}

model Charge {
  id             String       @id @default(cuid())
  clientId       String
  projectId      String?
  description    String
  amountCents    Int
  dueDate        DateTime
  paidAt         DateTime?
  status         ChargeStatus @default(DRAFT)
  paymentMethod  String?
  asaasPaymentId String?      @unique
  invoiceUrl     String?
  /// Lançamento (e parcela) do Financeiro que esta cobrança paga, quando criada pelo portal do cliente.
  financialEntryId String?
  installmentNumber Int?
  /// Última parcela coberta, quando o cliente paga várias de uma vez (da installmentNumber até esta). Null: só uma.
  installmentThrough Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([clientId, dueDate])
  @@index([financialEntryId, installmentNumber])
}

model Quote {
  id              String         @id @default(cuid())
  clientId        String
  projectId       String?
  code            String         @unique
  title           String
  scope           String
  estimatedHours  Int
  estimatedDays   Int
  pricingMethod   QuotePricingMethod @default(FIXED)
  pricingRateCents Int?
  amountCents     Int
  discountCents   Int            @default(0)
  /// Desconto percentual em pontos-base (1050 = 10,5%). Nulo quando o desconto é um valor fixo.
  discountPercentBps Int?
  costCents       Int?
  documentContent Json?
  terms           String?
  validUntil      DateTime?
  status          DocumentStatus @default(DRAFT)
  aiAnalysis      Json?
  paymentNotes    String?
  /// Null enquanto o orçamento estiver pendente de conclusão no editor.
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items           QuoteServiceItem[]
  payments        QuotePayment[]
  images          QuoteImage[]
  documents       ClientDocument[]
  sale            Sale?
  signedCopies    SignedDocument[]

  @@index([status, validUntil])
  @@index([status, createdAt, id])
  @@index([clientId, createdAt])
  @@index([completedAt, updatedAt, id])
}

/// Valores já recebidos que abatem o total de um orçamento.
model QuotePayment {
  id          String   @id @default(cuid())
  quoteId     String
  amountCents Int
  paidAt      DateTime
  createdAt   DateTime @default(now())
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, paidAt, id])
}

/// Imagens inseridas no PDF de um orçamento ou de um documento do cliente. Arquivos pequenos (até 4 MB), limitados por documento.
model QuoteImage {
  id         String          @id @default(cuid())
  quoteId    String?
  documentId String?
  mimeType   String
  width      Int
  height     Int
  byteSize   Int
  data       Bytes
  createdAt  DateTime        @default(now())
  quote      Quote?          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  document   ClientDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([documentId, createdAt])
}

enum ClientDocumentKind {
  CONTRACT
  IP_ASSIGNMENT
  TECHNICAL_MEMORIAL
}

/// Documentos produzidos para o cliente além da proposta comercial: contrato, cessão de direitos e memorial técnico.
model ClientDocument {
  id              String             @id @default(cuid())
  clientId        String
  /// Proposta de referência: traz os serviços para o documento. Opcional.
  quoteId         String?
  kind            ClientDocumentKind
  code            String             @unique
  title           String
  documentContent Json?
  /// Null enquanto o documento estiver pendente de conclusão no editor.
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote           Quote?             @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  images          QuoteImage[]
  signedCopies    SignedDocument[]

  @@index([clientId, kind, createdAt])
  @@index([kind, updatedAt, id])
  @@index([updatedAt, id])
  @@index([quoteId])
}

model Sale {
  id          String     @id @default(cuid())
  clientId    String
  quoteId     String?    @unique
  code        String     @unique
  title       String
  description String?
  amountCents Int
  origin      SaleOrigin
  status      SaleStatus @default(PENDING)
  confirmedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote       Quote?     @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdAt, id])
  @@index([clientId, createdAt])
}

/// Livro-caixa. Mantém snapshots textuais para preservar o histórico mesmo
/// quando o cadastro ou documento de origem for alterado posteriormente.
model FinancialEntry {
  id           String               @id @default(cuid())
  type         FinancialEntryType
  status       FinancialEntryStatus @default(PENDING)
  origin       FinancialEntryOrigin @default(MANUAL)
  sourceKey    String?              @unique
  description  String
  category     String
  counterparty String?
  amountCents  Int
  isFixed      Boolean              @default(false)
  dueDate      DateTime
  settledAt    DateTime?
  notes        String?
  /// Soma dos recebimentos (entradas) ou pagamentos (saídas) já registrados. Atualizada junto com FinancialPayment.
  paidCents    Int                  @default(0)
  /// Recorrência que gerou este lançamento (uma ocorrência por mês).
  recurringEntryId String?
  /// Condição especial de pagamento combinada ("Mensal no Pix", "Boleto em 10x"). Lançamentos com condição
  /// aparecem na área Condições especiais, independentemente da data.
  paymentCondition String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  payments     FinancialPayment[]
  installments FinancialInstallment[]
  recurringEntry RecurringEntry?    @relation(fields: [recurringEntryId], references: [id], onDelete: SetNull)

  @@index([status, dueDate, id])
  @@index([type, dueDate, id])
  @@index([createdAt, id])
  @@index([recurringEntryId, dueDate])
  @@index([paymentCondition, status, dueDate])
}

/// Parcelas de uma entrada: datas e valores combinados para receber. Os recebimentos registrados quitam as parcelas
/// em ordem (a primeira parcela primeiro). Sem parcelas, a entrada vence de uma vez no seu vencimento.
model FinancialInstallment {
  id          String         @id @default(cuid())
  entryId     String
  number      Int
  dueDate     DateTime
  amountCents Int
  createdAt   DateTime       @default(now())
  entry       FinancialEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, number])
  @@index([dueDate])
}

/// Entrada ou saída que se repete todo mês (custo fixo, mensalidade). Cada mês vira um FinancialEntry,
/// gerado sob demanda até o mês consultado. Dias que não existem no mês (31 em novembro) caem no último dia.
model RecurringEntry {
  id               String             @id @default(cuid())
  type             FinancialEntryType
  description      String
  category         String
  counterparty     String?
  amountCents      Int
  /// Dia do vencimento (1 a 31).
  dayOfMonth       Int
  /// Primeiro mês (dia 1, meio-dia UTC).
  startsOn         DateTime
  /// Último mês, quando encerrada.
  endsOn           DateTime?
  /// Último mês já gerado.
  generatedThrough DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  entries          FinancialEntry[]

  @@index([endsOn, generatedThrough])
  @@index([type, createdAt, id])
}

/// Valores efetivamente recebidos ou pagos de um lançamento. Um lançamento pode ser quitado em várias partes;
/// ele fica realizado quando a soma alcança o valor esperado.
model FinancialPayment {
  id          String         @id @default(cuid())
  entryId     String
  amountCents Int
  paidAt      DateTime
  notes       String?
  /// Quitação lançada ao marcar a venda como paga; sai se a venda voltar a ficar em aberto.
  fromSale    Boolean        @default(false)
  /// Pagamento registrado na proposta comercial; acompanha as alterações feitas nela.
  fromQuote   Boolean        @default(false)
  /// Cobrança online (Asaas) que gerou este pagamento; impede registrar o mesmo pagamento duas vezes.
  chargeId    String?        @unique
  createdAt   DateTime       @default(now())
  entry       FinancialEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, paidAt, id])
  @@index([paidAt])
}

model QuoteServiceItem {
  id                   String             @id @default(cuid())
  quoteId              String
  serviceCatalogItemId String?
  name                 String
  categoryName         String
  proposalText         String?
  billingType          ServiceBillingType
  pricingMethod        ServicePricingMethod @default(FIXED)
  billingCycle         String?
  quantity             Int                @default(1)
  pricingRateCents     Int?
  unitAmountCents      Int
  totalAmountCents     Int
  estimatedHours       Int?
  createdAt            DateTime           @default(now())
  quote                Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceCatalogItem   ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)

  @@index([quoteId, createdAt])
  @@index([serviceCatalogItemId])
}

model Subscription {
  id            String             @id @default(cuid())
  clientId      String
  serviceCatalogItemId String?
  name          String
  amountCents   Int
  billingCycle  String             @default("MONTHLY")
  status        SubscriptionStatus @default(ACTIVE)
  nextPaymentAt DateTime?
  startedAt     DateTime           @default(now())
  cancelledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  client        Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceCatalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([status, nextPaymentAt])
  @@index([serviceCatalogItemId, status])
}

model Contract {
  id              String         @id @default(cuid())
  clientId        String
  projectId       String?
  code            String         @unique
  title           String
  terms           String
  deliveryDate    DateTime?
  amountCents     Int?
  status          DocumentStatus @default(DRAFT)
  signedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model MonitoredApp {
  id                String           @id @default(cuid())
  clientId          String?
  projectId         String?
  name              String
  url               String?
  healthEndpoint    String?
  logsEndpoint      String?
  environment       String           @default("production")
  status            MonitoringStatus @default(UNKNOWN)
  lastCheckedAt     DateTime?
  lastResponseMs    Int?
  lastIncidentAt    DateTime?
  /// Resumo da última verificação ("HTTP 200 · banco ok 12 ms · versão 1.4.2").
  lastCheckSummary  String?
  /// Próxima verificação automática (o agendador reserva o sistema avançando esta data).
  nextCheckAt       DateTime?
  /// Último e-mail de alerta de indisponibilidade (para lembretes enquanto continuar fora).
  lastAlertAt       DateTime?
  sslExpiresAt      DateTime?
  sslIssuer         String?
  sslCheckedAt      DateTime?
  sslError          String?
  /// Menor aviso de vencimento já enviado (30, 7 ou 1 dia), para não repetir.
  sslAlertedDays    Int?
  domainName        String?
  domainExpiresAt   DateTime?
  domainCheckedAt   DateTime?
  domainError       String?
  domainAlertedDays Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  client            Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events            MonitoringEvent[]
  checks            MonitoringCheck[]

  @@index([status, lastCheckedAt])
  @@index([nextCheckAt])
  @@index([clientId, createdAt, id])
}

model MonitoringEvent {
  id             String              @id @default(cuid())
  monitoredAppId String
  type           MonitoringEventType
  severity       String              @default("info")
  title          String
  details        String?
  metadata       Json?
  occurredAt     DateTime            @default(now())
  resolvedAt     DateTime?
  monitoredApp   MonitoredApp        @relation(fields: [monitoredAppId], references: [id], onDelete: Cascade)

  @@index([monitoredAppId, occurredAt])
  @@index([type, severity])
}

/// Integração de pagamentos (Asaas), configurada em Integrações na gestão. A chave fica criptografada
/// (INTEGRATION_ENCRYPTION_KEY) e do token do webhook só se guarda o hash.
model PaymentIntegration {
  id                    String   @id @default(cuid())
  provider              String   @unique
  isActive              Boolean  @default(false)
  environment           String   @default("sandbox")
  apiKeyEncrypted       String?
  /// Últimos 4 caracteres da chave, para identificar qual está salva.
  keyHint               String?
  webhookTokenHash      String?
  webhookId             String?
  webhookUrl            String?
  /// Situação do webhook no Asaas: ACTIVE, INTERRUPTED (fila parada), DISABLED ou MISSING.
  webhookStatus         String?
  webhookPenalized      Int?
  accountName           String?
  accountEmail          String?
  accountDocument       String?
  accountStatus         String?
  /// Última verificação da conexão e do webhook, com o erro, se houve.
  lastCheckedAt         DateTime?
  lastError             String?
  /// Última conferência das cobranças em aberto direto no Asaas (cobre webhooks perdidos).
  lastSyncAt            DateTime?
  /// Cobrança automática: a cobrança da próxima parcela é gerada no Asaas estes dias antes do vencimento. Null desliga.
  autoChargeDays        Int?     @default(7)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model GatewayEvent {
  id                String   @id @default(cuid())
  provider          String
  eventKey          String   @unique
  eventName         String
  providerPaymentId String?
  amountCents       Int?
  occurredAt        DateTime?
  processedAt       DateTime?
  error             String?
  /// Tentativas de processamento (o agendador reprocessa até 5 vezes).
  attempts          Int      @default(0)
  /// Só os campos da cobrança usados no processamento (status, valor e datas), não o payload inteiro.
  payload           Json?
  receivedAt        DateTime @default(now())

  @@index([provider, receivedAt])
  @@index([processedAt, receivedAt])
  @@index([providerPaymentId])
}

/// Envios de e-mail (testes e, depois, os automáticos), com o resultado do servidor SMTP.
model EmailLog {
  id          String   @id @default(cuid())
  kind        String
  status      String
  toAddress   String
  subject     String
  messageId   String?
  /// Resposta do servidor SMTP ou diagnóstico da conexão (limitado).
  response    String?
  error       String?
  durationMs  Int?
  actorEmail  String?
  createdAt   DateTime @default(now())

  @@index([createdAt, id])
  @@index([status, createdAt])
}

/// Eventos da aplicação (logins, senhas, acessos, envios e erros), separados por origem e nível.
/// Append-only, com retenção de 90 dias.
model SystemLog {
  id         String   @id @default(cuid())
  source     String
  level      String
  event      String
  message    String
  actorEmail String?
  ip         String?
  userAgent  String?
  /// Detalhes pequenos e sem segredos.
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt, id])
  @@index([source, level, createdAt])
  @@index([event, createdAt])
}

/// Cada verificação de um sistema monitorado (manual ou automática), para uptime e tempo de resposta. Retenção de 90 dias.
model MonitoringCheck {
  id             String           @id @default(cuid())
  monitoredAppId String
  status         MonitoringStatus
  responseMs     Int
  statusCode     Int?
  summary        String?
  checkedAt      DateTime         @default(now())
  monitoredApp   MonitoredApp     @relation(fields: [monitoredAppId], references: [id], onDelete: Cascade)

  @@index([monitoredAppId, checkedAt])
  @@index([checkedAt])
}

/// Estado das tarefas agendadas (por exemplo, a data do último resumo diário enviado).
model SchedulerState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Aviso do cliente, pelo portal, de que fez um pagamento (Pix ou transferência). Você confere e registra no Financeiro.
model PaymentNotice {
  id                String    @id @default(cuid())
  clientId          String
  financialEntryId  String
  installmentNumber Int?
  amountCents       Int
  paidOn            DateTime
  message           String?
  /// PENDING até você registrar o pagamento ou descartar o aviso.
  status            String    @default("PENDING")
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([financialEntryId, status])
  @@index([clientId, createdAt])
  @@index([status, createdAt])
}

/// Via assinada de uma proposta ou documento, enviada pelo cliente no portal (PDF assinado no assinador gov.br).
/// Arquivo limitado a 8 MB e a 5 envios por documento; o conteúdo só é lido no download.
model SignedDocument {
  id                String          @id @default(cuid())
  clientId          String
  quoteId           String?
  documentId        String?
  fileName          String
  byteSize          Int
  sha256            String
  /// O PDF traz um campo de assinatura digital (/ByteRange), como os assinados no gov.br.
  signatureDetected Boolean
  data              Bytes
  uploadedBy        String?
  createdAt         DateTime        @default(now())
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quote             Quote?          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  document          ClientDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
